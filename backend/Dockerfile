# Використовуємо легку версію Node.js 20
FROM node:20-alpine

# Встановлюємо робочу директорію всередині контейнера
WORKDIR /app

# Копіюємо package.json та package-lock.json
COPY package*.json ./

# Встановлюємо залежності
RUN npm install

# Копіюємо весь інший код бекенду
COPY . .

# Відкриваємо порт 3000
EXPOSE 3000

# Запускаємо сервер (для звіту можна використовувати dev-режим або звичайний старт)
CMD ["npm", "run", "dev"]